# Product stack environment — copy to secrets/openchamber.env (mode 0600) and fill in.
# Consumed by compose/compose.yml and scripts/start.sh.

# Required: dedicated UI password for OpenChamber (used for browser access).
# Generate one with: openssl rand -base64 24
OPENCHAMBER_UI_PASSWORD=

# Optional overrides
# OPENCHAMBER_IMAGE=openchamber:local
# SINGULARITY_NETWORK=singularity-product-net

# Optional: Claude Office image (built from the public fork — see office/README.md)
# CLAUDE_OFFICE_IMAGE=claude-office:local

# Optional: Ghost — persistent companion agent that dreams (see ghost/README.md and docs/GHOST-SETUP.md)
# Enable with `bash ghost/setup-ghost.sh` or `python3 scripts/provision-secrets.py --with-ghost`
# The model lane below is DERIVED from the memory stack configuration (the same
# proxy, lane and space id as the main-agent memory); set it only to point the
# dream daemon at a different, registered endpoint.
# GHOST_TIMEZONE=UTC
# GHOST_UPSTREAM_BASE=http://proxy:8096/claude-code/default/v1
# GHOST_DREAM_GATEWAY_URL=http://proxy:8096/claude-code/default/v1
# GHOST_BACKEND=openchamber
# GHOST_DREAM_CHECK_INTERVAL_SEC=3600
