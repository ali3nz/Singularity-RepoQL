{
  "_comment": "Merge into ~/.claude/settings.json. Replace /path/to with the checkout path and set OFFICE_CONFIG (or OFFICE_ENDPOINT + OFFICE_INGEST_KEY) in your environment. Events carry whitelisted metadata only — never prompts or tool I/O.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node /path/to/adapters/claude-code/office-hook.mjs session-start" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node /path/to/adapters/claude-code/office-hook.mjs prompt" }] }],
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "node /path/to/adapters/claude-code/office-hook.mjs pre-tool" }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "node /path/to/adapters/claude-code/office-hook.mjs post-tool" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node /path/to/adapters/claude-code/office-hook.mjs stop" }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "node /path/to/adapters/claude-code/office-hook.mjs subagent-stop" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node /path/to/adapters/claude-code/office-hook.mjs session-end" }] }]
  }
}
