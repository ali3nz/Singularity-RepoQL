{
  "schema": 1,
  "platform": "windows-native",
  "variants": {
    "2": {
      "name": "Claude Code Full (Kanzo, Tencent MemoryCore, RepoQL, Dashboard, Claude Office, OpenMausBots)",
      "gui": "claude-desktop-code",
      "features": {
        "repoql_dashboard": true,
        "tencent_connector": true,
        "kanban": true,
        "agent_chat": true,
        "office": true,
        "memory": true,
        "repoql_mcp": true,
        "kanzo": true,
        "openmausbot": true,
        "ghost": false
      },
      "rustOfficeFeature": true,
      "rustGhostFeature": false
    }
  },
  "repoql": {
    "requiredVersion": "1.7.18",
    "connectorContract": "fetch-render",
    "binary": "externally-installed-native-rql.exe",
    "versionPolicy": "exact-match-fail-closed",
    "upgradePolicy": "explicit-connector-migration-and-acceptance"
  },
  "installProfiles": [
    "claude-code-full"
  ],
  "defaultVariant": 2
}
