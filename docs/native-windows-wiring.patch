 /**
+ * Native-Windows facts (no WSL): where the install would land and what can be
+ * proved. On Windows `HOME` is usually unset, `claude` is not on PATH, and POSIX
+ * mode bits do not exist — this section reports those facts instead of failing
+ * with a POSIX error or claiming ACL protection that was never checked.
+ */
+export function nativeWindowsCheck({ env = process.env, platform = process.platform } = {}) {
+  if (platform !== "win32") return { state: "NOT_APPLICABLE", detail: `host platform is ${platform}; native-Windows checks apply to win32 only` };
+  let home;
+  try { home = resolveHome({ env, platform }); }
+  catch (e) { return { state: "INCOMPLETE", detail: `home directory cannot be resolved: ${e?.message || e}` }; }
+  const claudeConfig = claudeConfigDir({ home, platform });
+  const exe = findClaudeExecutable({ env, platform, home });
+  const settingsPath = join(claudeConfig, "settings.json");
+  const problems = [];
+  if (!exe) problems.push("no Claude Code executable found on PATH, in %USERPROFILE%\\.local\\bin, or in %LOCALAPPDATA%\\Claude-Data");
+  if (!existsSync(settingsPath)) problems.push(`no Claude Code settings file at ${settingsPath}`);
+  if (problems.length) return { state: "INCOMPLETE", detail: problems.join("; ") };
+  return {
+    state: "CONFIGURED",
+    detail: `home ${home}; claude ${exe.kind} at ${exe.path}; settings ${settingsPath}; POSIX mode bits do not exist here (NTFS ACLs are not verified)`,
+  };
+}
