# MemoryCore capture consumer — every knob, capture OFF by default.
#
# Copy to /etc/singularity/capture.env (or the path your unit reads), chmod 0600.
# Capture is enabled ONLY by CAPTURE_ENABLED=1 in this file: the consumer and the
# unit both default to disabled, so an absent or unedited file reads nothing.

# --- enablement -------------------------------------------------------------
CAPTURE_ENABLED=0

# --- destination ------------------------------------------------------------
# MemoryCore gateway. Inside the memory stack network the service name resolves;
# from the host, point it at the published loopback port instead.
DEST_URL=http://tencent-memorycore:8420

# --- memory identity (REQUIRED once enabled; no defaults on purpose) --------
# Which team/user the captured conversations belong to. The installer or the
# operator must choose these; an empty value fails closed.
TEAM_ID=
USER_ID=
# Which MemoryCore service id to write through (defaults to the consumer's own).
TDAI_SERVICE_ID=default

# --- source -----------------------------------------------------------------
# Directory that holds OpenChamber's opencode.db, mounted read-only at /src.
# The default is the product's own data directory; do not point this at another
# agent's workspace.
SRC_DIR=~/.local/share/opencode/share

# --- ledger -----------------------------------------------------------------
# Cursor and per-session verification receipts. Must survive container restarts;
# the runner mounts SRC's parent config dir here.
LEDGER_PATH=/ledger/capture-ledger.json

# --- pacing and bounds ------------------------------------------------------
STABILITY_SECONDS=900
MAX_UNITS=50
CONSUMER_MAX_CHARS=
CONSUMER_MAX_BYTES=
CONSUMER_DELAY_MS=
CONSUMER_MAX_FAILURES=5

# --- per-day caps (unit caps are enforced by the consumer) ------------------
CAPTURE_DAILY_MAX_UNITS=500
CAPTURE_DAILY_MAX_MESSAGES=20000

# --- allowlist (comma/space separated agent names; empty = all admitted) ----
CAPTURE_ALLOW_AGENTS=

# --- runtime ----------------------------------------------------------------
# Image used to run the consumer. The live host runs the l1recordids overlay;
# this is the portable default. Override to pin a digest in production.
CAPTURE_IMAGE=tencent-memorycore:v2.0.2-99a1a2c-l1recordids1
# Docker network the MemoryCore gateway is reachable on.
MEMORY_NETWORK=tdai-memory-stack
# Optional: extra env file the container also reads (gateway key etc.).
GATEWAY_ENV_FILE=
