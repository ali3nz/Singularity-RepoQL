+/**
+ * L1 drain trigger (issue 658 backfill).
+ *
+ * Notifies the pipeline for an ALREADY-STORED session without writing L0, so a
+ * session whose L0 rows sit past its L1 cursor can be drained on demand. This is
+ * the only L0-safe way to drive L1 for idle/historical sessions: the add path
+ * mints `msg-${randomUUID()}`, so re-posting stored conversations would append
+ * duplicate L0 rows and re-create the duplicate-extraction defect.
+ *
+ * The notify does not need to cross the warmup threshold to be useful - it also
+ * arms the per-session L1 idle timer, which drains the session from its cursor.
+ */
+async function handleConversationFlush(
+  body: unknown,
+  auth: V2AuthContext,
+  requestId: string,
+  deps: V2RouterDeps,
+): Promise<ApiResponseEnvelope> {
+  const b = (body ?? {}) as Record<string, unknown>;
+  const sessionId = typeof b.session_id === "string" ? b.session_id.trim() : "";
+  if (!sessionId) return errorEnvelope(400, "session_id is required", requestId);
+  if (!deps.notifyPipeline) return errorEnvelope(503, "Pipeline notify is not available", requestId);
+  const iso = deps.requestIsolation;
+  try {
+    await deps.notifyPipeline(auth.serviceId, sessionId, 1, iso?.teamId, iso?.agentId);
+  } catch (err) {
+    return errorEnvelope(500, `notify failed: ${err instanceof Error ? err.message : String(err)}`, requestId);
+  }
+  return successEnvelope<{ notified: boolean; session_id: string }>({ notified: true, session_id: sessionId }, requestId);
+}
