# ─────────────────────────────────────────────────────────────────────────────
# Singularity — memory stack configuration (English template)
#
# Use one of:
#   cp .env.example upstream/.env     # fill in yourself; start-all.sh confirms
#   ./upstream/start-all.sh           # interactive; creates upstream/.env itself
#
# Variable names are identical to upstream/.env.example (whose annotations are
# in Chinese). Two parameter groups:
#   MEMORY_*  → memory core + hub (LLM used for extraction, summaries, knowledge)
#   PROXY_*   → the proxy's upstream LLM (where your coding agent's requests go)
# ─────────────────────────────────────────────────────────────────────────────

# ── image tags ───────────────────────────────────────────────────────────────
# Public Docker Hub images (multi-arch; no login). Pin explicit versions for
# reproducibility; `PULL=1 ./start-all.sh` refreshes :latest.
MEMORY_CORE_IMAGE=agentmemory/memory-core:latest
MEMORY_HUB_IMAGE=agentmemory/memory-hub:latest
PROXY_IMAGE=agentmemory/memory-proxy:latest

# ── memory group: LLM used by memory core / hub ──────────────────────────────
# Used for embed/summarize and knowledge ingest. Any OpenAI- or
# Anthropic-compatible endpoint.
MEMORY_LLM_BASE_URL=REPLACE_ME            # e.g. https://api.deepseek.com/v1
MEMORY_LLM_API_KEY=REPLACE_ME
MEMORY_LLM_MODEL=REPLACE_ME               # e.g. deepseek-chat
MEMORY_LLM_PROTOCOL=openai                # openai | anthropic

# ── proxy group: upstream LLM the proxy forwards to ─────────────────────────
PROXY_UPSTREAM_URL=REPLACE_ME             # e.g. https://api.deepseek.com/v1
PROXY_UPSTREAM_API_KEY=REPLACE_ME         # may differ from the memory group
PROXY_UPSTREAM_MODEL=REPLACE_ME           # e.g. deepseek-chat

# ── ports ────────────────────────────────────────────────────────────────────
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# ── knowledge service reachable base URL (required by memory-hub) ────────────
# Must include the /v3 prefix. host.docker.internal lets containers loop back
# to the host on Docker Desktop; on Linux, replace with the host IP or add an
# extra_hosts mapping (host.docker.internal:host-gateway).
KNOWLEDGE_PUBLIC_BASE_URL=http://host.docker.internal:8424/v3

# ── panel "client access" card URL (optional) ────────────────────────────────
# Base URL the Panel shows to agent clients (points at the proxy, not the core).
# Unset → the script auto-detects the host LAN IP. Set empty ("") to fall back
# to the gateway endpoint. Set explicitly for public hostnames or fixed NICs.
# MEMORY_HUB_PROXY_PUBLIC_URL=http://192.0.2.100:8096

# ── volumes ──────────────────────────────────────────────────────────────────
MEMORY_CORE_VOLUME=tdai-memory-core-data
PANEL_VOLUME=tdai-panel-data

# ── storage backend (optional) ───────────────────────────────────────────────
# sqlite (default) — zero extra dependencies, data in MEMORY_CORE_VOLUME.
# mongodb — experimental; requires Mongo 7.0+ with mongot. Prefer running
# ./start-all-mongo.sh, which sets MEMORY_CORE_STORE_MODE and reuses the
# start-all.sh flow. Leave commented for sqlite.
# MEMORY_CORE_STORE_MODE=mongodb
# MONGODB_ENDPOINT=mongodb://user:pass@your-mongo:27017/?directConnection=true
# MONGODB_DATABASE=tdai_memory
# MEMORY_CORE_METADATA_BACKEND=auto

# ── credentials ──────────────────────────────────────────────────────────────
# Gateway bearer layer. Empty (default) = disabled — local zero-config mode.
# NOTE: the proxy does not send this header, so a non-empty value breaks the
# proxy's auth/sessionInit until upstream fixes it. Leave empty for local use.
MEMORY_CORE_GATEWAY_API_KEY=

# Panel ↔ Knowledge service key. Empty (default) = the start script generates a
# random ks-svc-* value and writes it back to this file.
KNOWLEDGE_SERVICE_KEY=

# Admin username for first init. The admin user key (sk-mem-*) is generated on
# first start and stored in upstream/.admin-key.
MEMORY_CORE_ADMIN_USERNAME=admin

# ── memory prompt family ─────────────────────────────────────────────────────
# code (default) — engineering/team memory: facts, tasks, decisions, SOPs
# chat           — personal/episodic memory (persona, episodes, instructions)
MEMORY_PROMPT_MODE=code

# ── proxy pipeline mode (optional) ───────────────────────────────────────────
# 1 (default) = auth + sessionInit + memory injection enabled.
# 0 = plain pass-through proxy.
# PROXY_FULL_STACK=1
