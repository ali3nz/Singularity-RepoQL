{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },
  // RepoQL code intelligence — needs the rql binary on the runtime PATH.
  // See docs/REPOQL-SETUP.md and compose/repoql.override.yml.
  "mcp": {
    "repoql": {
      "type": "local",
      "command": ["/usr/local/bin/rql", "mcp"],
      "enabled": true
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@3.2.0"
  ]
}
