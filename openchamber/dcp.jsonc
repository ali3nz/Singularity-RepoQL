{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "enabled": true,
  "autoUpdate": false,
  "manualMode": {
    "enabled": false
  },
  "turnProtection": {
    "enabled": true,
    "turns": 6
  },
  "compress": {
    "mode": "range",
    "permission": "allow",
    "minContextLimit": "50%",
    "maxContextLimit": "70%",
    "nudgeForce": "soft"
  },
  "strategies": {
    "deduplication": {
      "enabled": true
    },
    "purgeErrors": {
      "enabled": false
    }
  }
}
