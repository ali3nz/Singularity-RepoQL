{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "singularity-llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "User configured LLM",
      "options": {
        "baseURL": "{env:SINGULARITY_LLM_BASE_URL}",
        "apiKey": "{env:SINGULARITY_LLM_API_KEY}"
      },
      "models": {
        "example-model": {
          "name": "Configured model"
        }
      }
    }
  }
}
