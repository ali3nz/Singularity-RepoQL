# Copy to .env (or pass with --env-file) and edit for your machine.
# Every value is local to YOUR installation. There are no fleet defaults.

# --- core ------------------------------------------------------------------
SINGULARITY_WORKSPACE=/srv/singularity/workspace
SINGULARITY_RQL_BIN=/usr/local/bin/rql
SINGULARITY_STATE_DIR=/var/lib/singularity-dashboard
SINGULARITY_BIND=127.0.0.1
SINGULARITY_PORT=18100
SINGULARITY_ALLOW_PEERS=127.0.0.1/32,::1/128
SINGULARITY_SAMPLE_INTERVAL=30
SINGULARITY_CPU_RETENTION_DAYS=30

# --- optional public access (your own Cloudflare Access application) --------
# Leave both empty for loopback + SSH-tunnel use only.
SINGULARITY_PUBLIC_URL=
SINGULARITY_ACCESS_TEAM=
SINGULARITY_ACCESS_AUD=

# --- native panels (all fixed loopback upstreams; none are shipped) --------
# RepoQL's own dashboard proxy needs the official `rql dashboard --url` issuer.
SINGULARITY_REPOQL_EMBED_URL=/embed/repoql
SINGULARITY_REPOQL_LOGIN_FILE=/var/lib/singularity-dashboard/native_repoql_login.url

SINGULARITY_TENCENT_HOST=127.0.0.1
SINGULARITY_TENCENT_PORT=8125
SINGULARITY_TENCENT_OWNER_KEY_FILE=/etc/singularity-dashboard/tencent-owner.key
TENCENT_PANEL_BASE=http://127.0.0.1:8125
TENCENT_SKILL_GATEWAY_BASE=http://127.0.0.1:8126

SINGULARITY_OFFICE_HOST=127.0.0.1
SINGULARITY_OFFICE_PORT=8001
CLAUDE_OFFICE_PUBLIC_URL=https://office.example.com
CLAUDE_OFFICE_EMBED_URL=https://office.example.com/?token=REPLACE_WITH_YOUR_TOKEN&embed=1

# Kanzo is a separate, unmodified AGPL-3.0-only process. Bind it to loopback.
SINGULARITY_KANZO_HOST=127.0.0.1
SINGULARITY_KANZO_PORT=4242

# --- optional observers (leave empty to report "unconfigured") -------------
SINGULARITY_GHOST_SNAPSHOT=
SINGULARITY_GHOST_CONTROL_SOCKET=
SINGULARITY_AGENTCHAT_STATE_DIR=
SINGULARITY_OPENCHAMBER_SUMMARY_FILE=
SINGULARITY_FREEBUCKS_STATUS_MODULE=
SINGULARITY_HOST_LABEL=local

# Harness telemetry inputs are user-owned runtime data, kept outside this tree.
SINGULARITY_HARNESS_DATA_DIR=/var/lib/singularity-dashboard/harness
HARNESS_RUNS_DIR=
HARNESS_HUB_DIR=
HARNESS_AUDIT_LOG=
HARNESS_DESKTOP_DB_GLOB=

# Optional coordinator / unified data plane (external, loopback only).
RUST_HARNESS_URL=http://127.0.0.1:7879
RUST_HARNESS_TOKEN_FILE=
UNIFIED_SERVICE_BASE=http://127.0.0.1:18101
UNIFIED_GATEWAY_TOKEN_FILE=
