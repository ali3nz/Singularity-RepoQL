# Native Windows source-review example, NOT an installable release.
# Set these in your own Windows user environment; no WSL or Docker required
# for the intended native application. A working Tencent/RepoQL/Ghost/Office
# stack and GUI plugin registration have NOT been validated.
SINGULARITY_WINDOWS_NATIVE=1
SINGULARITY_INSTALL_VARIANT=2
SINGULARITY_BIND=127.0.0.1
SINGULARITY_ALLOW_PEERS=127.0.0.1,::1
# SINGULARITY_RQL_BIN must point to an independently installed rql.exe 1.7.18
# SINGULARITY_NATIVE_BRIDGE_EXE must point to a compiled Rust executable
# SINGULARITY_OFFICE_NATIVE_AUTH_MODE=legacy_url is the complete variant default
# Do not place bearer tokens or Office token URLs in this example file.
