<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- This MSI installs verified source and compiled Windows executables only.
       User-scoped credential and task provisioning is deliberately separate. -->
  <Package Name="Singularity RepoQL Windows (Preview)"
           Manufacturer="Singularity RepoQL"
           Version="0.1.0.0"
           UpgradeCode="A4059181-F59A-4C8D-B098-E26C9111B74E"
           Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer Singularity RepoQL package is already installed." />
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Singularity RepoQL" />
    </StandardDirectory>
    <Feature Id="ProductFeature" Title="Singularity RepoQL Windows" Level="1">
      <ComponentGroupRef Id="ProductPayload" />
    </Feature>
  </Package>
  <Fragment>
    <ComponentGroup Id="ProductPayload" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.Payload)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
