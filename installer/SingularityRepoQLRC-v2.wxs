<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Fleet861 RC v2. Byte-for-byte the v1 package identity except for two
       values that MSI major-upgrade semantics require to change:
          1. Version 0.2.0.0 (higher than v1 0.1.0.0).
          2. A distinct ProductCode, because a major upgrade installs a new
             product and removes the old one through FindRelatedProducts/
             RemoveExistingProducts driven by the shared UpgradeCode.
       The UpgradeCode is deliberately unchanged (7F2C4D19-5A6B-4C7E-9B3D-
       1E8A0C5D2F61), which is what lets the v2 package recognise, replace and
       clean up v1 while still being unable to touch the production package
       (different UpgradeCode, perMachine scope, ProgramFiles root).
       Install root stays %LOCALAPPDATA%\Singularity\Fleet861RC per the director
       decision of 2026-11-05. -->
  <Package Name="Singularity RepoQL Windows (Fleet861 RC)"
           Manufacturer="Singularity RepoQL"
           Version="0.2.0.0"
           ProductCode="4E7B62D5-9C31-4A8F-B2D7-5F0C8E3A6B94"
           UpgradeCode="7F2C4D19-5A6B-4C7E-9B3D-1E8A0C5D2F61"
           Scope="perUser" Compressed="yes">
    <!-- Per-user install must be enforced by MSI properties, not only by
         Scope="perUser": on an elevated client (this host's SSH session is
         elevated) Windows Installer otherwise falls back to a per-machine
         install and registers the product under HKLM. ALLUSERS=2 with
         MSIINSTALLPERUSER=1 keeps the ARP entry, file targets and state in the
         calling user's profile, which is what makes the RC entry removable
         without elevation and keeps it in a different registry hive from the
         production product. -->
    <Property Id="ALLUSERS" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />
    <MajorUpgrade DowngradeErrorMessage="A newer Singularity RepoQL Fleet861 RC package is already installed." />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Singularity\Fleet861RC" />
    </StandardDirectory>
    <Feature Id="ProductFeature" Title="Singularity RepoQL Windows (Fleet861 RC)" Level="1">
      <ComponentGroupRef Id="ProductPayload" />
    </Feature>
  </Package>
  <Fragment>
    <ComponentGroup Id="ProductPayload" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.Payload)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
